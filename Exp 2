class Calculator {
    private double num1, num2;

    // Default constructor
    Calculator() {
        num1 = 10;
        num2 = 20;
    }

    // Parameterized constructor
    Calculator(double a, double b) {
        num1 = a;
        num2 = b;
    }

    // Method overloading
    int add(int a, int b) {
        return a + b;
    }

    double add(double a, double b) {
        return a + b;
    }

    // Adds the values stored through the constructor
    double add() {
        return num1 + num2;
    }
}

public class CalculatorDemo {
    public static void main(String[] args) {
        Calculator c1 = new Calculator();
        Calculator c2 = new Calculator(5.5, 4.5);

        System.out.println("Default values sum   : " + c1.add());
        System.out.println("User values sum      : " + c2.add());
        System.out.println("Integer addition     : " + c1.add(7, 8));
        System.out.println("Double addition      : " + c1.add(7.5, 8.25));
    }
}
