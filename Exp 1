import java.util.Scanner;

class Student {
    String name;
    String uin;
    double cgpa;

    Student(String name, String uin, double cgpa) {
        this.name = name;
        this.uin = uin;
        this.cgpa = cgpa;
    }

    void display() {
        System.out.printf("%-20s %-15s %.2f%n", name, uin, cgpa);
    }
}

public class StudentInfo {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter number of students: ");
        int n = sc.nextInt();
        sc.nextLine();

        Student[] students = new Student[n];

        for (int i = 0; i < n; i++) {
            System.out.println("\nEnter details of student " + (i + 1));
            System.out.print("Name: ");
            String name = sc.nextLine();
            System.out.print("UIN: ");
            String uin = sc.nextLine();
            System.out.print("CGPA: ");
            double cgpa = sc.nextDouble();
            sc.nextLine();
            students[i] = new Student(name, uin, cgpa);
        }

        System.out.println("\n----- Student Information -----");
        System.out.printf("%-20s %-15s %s%n", "Name", "UIN", "CGPA");
        for (Student s : students) {
            s.display();
        }
        sc.close();
    }
}
